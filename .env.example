# =============================================================================
# Aero Piston Engine Digital Twin — stack-level environment (template)
#
# Copy to `.env` (git-ignored) before running `docker compose up --build`.
#
# WHY THE SECRET LIVES AT THE ROOT AND NOT IN THE APP'S .env
# ----------------------------------------------------------
# The backend reads TELEMETRY_SECRET_KEY straight from the process environment:
#
#   src/core/config.py:1183                  os.environ.get(...)   # prod gate
#   src/l1_data/telemetry_security.py:74     os.environ.get(...)   # HMAC signer
#
# Nothing calls load_dotenv(), so a line in the app-level `.env` never reaches
# os.environ and is silently inert. A root `.env` works because docker compose
# interpolates it into the container's `environment:` block, which *is* a real
# process environment variable.
#
# THIS REPOSITORY IS PUBLIC. Never commit a real secret. Set it here instead.
# =============================================================================

# --- Secrets -------------------------------------------------------------
# HMAC key that authenticates ingested telemetry packets. Mandatory once
# APP_APP_ENV=production: startup aborts without it and PacketSigner refuses
# to sign. Generate one with:
#   openssl rand -hex 32
# The development placeholder in config/default.yaml is deliberately rejected
# in production.
TELEMETRY_SECRET_KEY=

# Bearer token protecting state-changing ML endpoints (POST /api/v1/ml/rollback).
# Unset means those endpoints return 503 and stay disabled (fail closed).
TWIN_API_BEARER_TOKEN=

# --- Stack mode ----------------------------------------------------------
# development | staging | production
APP_APP_ENV=development
APP_LOG_LEVEL=INFO

# --- CORS ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. The frontend's
# origin must appear here or its REST calls are blocked by the browser
# (WebSockets are unaffected and keep working, which hides the failure).
APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Frontend build-time URLs -------------------------------------------
# Inlined into the client bundle when the web image is built, so a rebuild is
# required after changing them. Use https:// and wss:// in production.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws/engine

# --- Optional backend overrides -----------------------------------------
# APP_DATABASE_URL=sqlite+aiosqlite:///./data/digital_twin.db
# APP_TELEMETRY_SOURCE=simulator
