# =============================================================================
# Piston Engine Digital Twin — Environment Variables (template)
#
# Copy to `.env` for local development.
#
# NOTE ON NAMING: AppSettings is configured with `env_prefix="APP_"`, so every
# application-level setting is addressed as APP_<FIELD>. Unprefixed names such
# as APP_ENV or API_PORT are silently ignored.
#
# PRIORITY: `config/default.yaml` is passed as constructor arguments, which
# outrank environment variables. Only settings absent from that YAML (including
# everything below) can be overridden here.
# =============================================================================

# --- Application ---
# Must be development|staging|production. Setting "production" makes startup
# FAIL unless TELEMETRY_SECRET_KEY is also a real process environment variable
# (see the security section below) — a .env entry alone is not visible to that
# check, because it reads os.environ directly.
APP_APP_ENV=development
APP_LOG_LEVEL=INFO

# --- Configuration ---
APP_CONFIG_PATH=config/default.yaml

# --- Database ---
# SQLite for development (no external DB needed)
APP_DATABASE_URL=sqlite+aiosqlite:///./digital_twin.db
# PostgreSQL for production:
# APP_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/digital_twin

# --- API ---
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_API_WORKERS=1

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API. The defaults
# cover every port the UI actually runs on: 8080 is what `npm run dev` binds,
# and the root compose stack serves it on 3000. Deployed frontends MUST be added
# here or the browser will block every REST call. WebSockets are unaffected by
# CORS, so a mismatch shows up only as silently failing (or "offline"-looking)
# REST data.
# Use "*" to allow any origin — development only; credentials are then disabled.
APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8000,http://127.0.0.1:8080

# --- Telemetry ---
APP_TELEMETRY_SOURCE=simulator
# Options: simulator, csv_replay, live
APP_CSV_REPLAY_PATH=data/sample_flights/

# --- ML Models ---
# Model artifacts (*.onnx / *.joblib) are NOT committed — see PRODUCTION_DEPLOYMENT.md.
# Without them the ML endpoints report MODEL_UNAVAILABLE and the deterministic
# physics rules handle diagnostics instead.
APP_MODEL_DIR=models/

# --- Security ---
# Name of the process environment variable holding the HMAC secret used to
# verify ingested telemetry packets. The name is fixed by SecurityConfig; only
# export TELEMETRY_SECRET_KEY itself, never commit a real value:
#   export TELEMETRY_SECRET_KEY="$(openssl rand -hex 32)"
# In production the built-in development default is rejected at startup.
# TELEMETRY_SECRET_KEY=replace-me
