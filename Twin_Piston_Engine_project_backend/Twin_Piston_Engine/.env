# =============================================================================
# Piston Engine Digital Twin — Environment (local development defaults)
#
# Committed on purpose so a fresh clone runs with zero setup. Contains no
# secrets: the HMAC key is injected at runtime as a genuine process environment
# variable (see TELEMETRY_SECRET_KEY below and .env.example).
#
# Naming: settings are read with an `APP_` prefix, so AppSettings fields are
# addressed as APP_<FIELD> (APP_API_PORT, not API_PORT).
# =============================================================================

APP_APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CONFIG_PATH=config/default.yaml

# SQLite for local development — no external database required.
APP_DATABASE_URL=sqlite+aiosqlite:///./digital_twin.db

APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_API_WORKERS=1

# Browser origins allowed to call the API. Add the deployed frontend origin
# here or its REST calls will be blocked by the browser.
APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

APP_TELEMETRY_SOURCE=simulator
APP_CSV_REPLAY_PATH=data/sample_flights/
APP_MODEL_DIR=models/

# Deliberately not set:
#   TELEMETRY_SECRET_KEY — the HMAC secret for telemetry ingestion. It must be
#   a real environment variable (openssl rand -hex 32), never a committed value,
#   and it becomes mandatory once APP_APP_ENV=production.
