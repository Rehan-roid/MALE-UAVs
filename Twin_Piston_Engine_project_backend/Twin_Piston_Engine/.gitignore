# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual environment ---
.venv/
venv/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment ---
# NOTE: .env is intentionally NOT ignored. It is committed with non-secret
# local development defaults so a fresh clone runs without manual setup, and so
# deployment images are reproducible. Never place a real HMAC secret in it:
# TELEMETRY_SECRET_KEY must be injected as a genuine process environment
# variable at runtime (see .env.example).
*.env.local

# --- Database ---
*.db
*.sqlite3

# --- ML models (large binaries) ---
models/*.onnx
models/*.pkl
models/*.joblib
models/**/*.joblib

# --- Data ---
data/

# --- Coverage ---
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- mypy ---
.mypy_cache/

# --- ruff ---
.ruff_cache/

# --- pytest ---
.pytest_cache/

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- Logs ---
*.log
logs/
