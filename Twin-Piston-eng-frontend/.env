# =============================================================================
# Twin-Piston Aero Engine Digital Twin — Frontend Environment (local default)
#
# These are non-secret local development values, committed so the project runs
# with zero setup after a clone. Override them in `.env.local` (git-ignored) or,
# for containers, via the Docker build arguments documented in the Dockerfile.
#
# Vite inlines VITE_* at build time — restart the dev server or rebuild after
# changing any value here.
# =============================================================================

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws/engine
