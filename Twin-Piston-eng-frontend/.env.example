# =============================================================================
# Twin-Piston Aero Engine Digital Twin — Frontend Environment Template
#
# Copy to `.env` for local development. Vite only exposes variables prefixed
# with VITE_ to the browser bundle.
#
# IMPORTANT: Vite inlines these values at BUILD time. They are read when the
# dev server starts or when `npm run build` runs — changing them requires a
# restart or a rebuild. For containers, pass them as build arguments (see
# Dockerfile) because `.env` is excluded from the Docker build context.
#
# Per-developer overrides belong in `.env.local`, which must not be committed.
# =============================================================================

# Base URL of the Ground Station REST API (Module 20).
# Local:  http://localhost:8000/api/v1
# Deployed: https://api.your-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket endpoint for the real-time diagnostic event stream.
# Local:  ws://localhost:8000/api/v1/ws/engine
# Deployed: wss://api.your-domain.com/api/v1/ws/engine  (wss, not ws, over HTTPS)
VITE_WS_URL=ws://localhost:8000/api/v1/ws/engine
